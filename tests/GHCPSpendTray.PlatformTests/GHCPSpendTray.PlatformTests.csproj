<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="GHCPSpendTray.Shared" />
    <ProjectReference Include="../../src/GHCPSpendTray.Application/GHCPSpendTray.Application.csproj" />
    <!-- UI-bound Store integration is exercised by AppTests. -->
    <Compile Include="..\..\src\GHCPSpendTray.App\Platform\*.cs"
             Exclude="..\..\src\GHCPSpendTray.App\Platform\StoreUpdates.cs"
             Link="Platform\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
